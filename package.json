{
  "name": "vscode-git-revision-graph",
  "displayName": "VSCode Git Revision Graph",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "tmatma",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/m-tmatma/vscode-git-revision-graph.git"
  },
  "bugs": {
    "url": "https://github.com/m-tmatma/vscode-git-revision-graph/issues"
  },
  "homepage": "https://github.com/m-tmatma/vscode-git-revision-graph#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=24"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "revision graph",
    "commit graph",
    "history",
    "branches"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "revisionGraph.show",
        "title": "%command.show.title%",
        "category": "Git Revision Graph",
        "icon": "$(git-branch)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "revisionGraph.show",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "revisionGraph",
          "title": "Git Revision Graph",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "revisionGraph": [
        {
          "id": "revisionGraph.welcomeView",
          "name": "Git Revision Graph",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "vsix": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@vscode/l10n": "^0.0.18"
  }
}
