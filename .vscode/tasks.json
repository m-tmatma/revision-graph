{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": {
          "regexp": "a^",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^watching for changes\\.\\.\\.$",
          "endsPattern": "^watching for changes\\.\\.\\.$"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
